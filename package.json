{
  "name": "is-midi",
  "version": "2.0.0",
  "description": "Check if a Buffer/Uint8Array is a MIDI file",
  "license": "MIT",
  "repository": "chrisvogt/is-midi",
  "author": {
    "name": "Chris Vogt",
    "email": "mail@chrisvogt.me",
    "url": "https://www.chrisvogt.me"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "xo && ava",
    "test:coverage": "c8 ava",
    "lint": "xo",
    "lint:fix": "xo --fix"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "keywords": [
    "mid",
    "midi",
    "music",
    "audio",
    "type",
    "detect",
    "check",
    "is",
    "binary",
    "buffer",
    "uint8array",
    "file-type",
    "magic-bytes"
  ],
  "devDependencies": {
    "ava": "^6.1.1",
    "c8": "^9.1.0",
    "xo": "^0.59.3"
  },
  "xo": {
    "rules": {
      "unicorn/prefer-module": "off"
    }
  }
}
